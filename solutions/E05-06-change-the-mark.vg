{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Left: a bar per car overlaps and says nothing (bars imply a zero baseline and a sum or a mean). Right: a bar that is meaningful (one aggregated value per category).",
  "data": {"url": "../data/cars.json"},
  "hconcat": [
    {
      "title": "Naive: point -> bar",
      "width": 250,
      "height": 250,
      "mark": "bar",
      "encoding": {
        "x": {"field": "Horsepower", "type": "quantitative"},
        "y": {"field": "Miles_per_Gallon", "type": "quantitative"}
      }
    },
    {
      "title": "Meaningful bar: mean MPG per number of cylinders",
      "width": 250,
      "height": 250,
      "mark": "bar",
      "encoding": {
        "x": {"field": "Cylinders", "type": "ordinal", "axis": {"labelAngle": 0}},
        "y": {"aggregate": "mean", "field": "Miles_per_Gallon", "type": "quantitative", "title": "Mean MPG"}
      }
    }
  ]
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "`joinaggregate` (all lowercase in the spec) keeps every row and adds the group mean as a new column; calculate then subtracts it.",
  "width": 400,
  "height": 150,
  "data": {"url": "../data/cars.json"},
  "transform": [
    {"filter": "datum.Miles_per_Gallon != null"},
    {
      "joinaggregate": [{"op": "mean", "field": "Miles_per_Gallon", "as": "origin_mean_mpg"}],
      "groupby": ["Origin"]
    },
    {"calculate": "datum.Miles_per_Gallon - datum.origin_mean_mpg", "as": "mpg_vs_origin_mean"}
  ],
  "mark": {"type": "circle", "opacity": 0.4},
  "encoding": {
    "x": {"field": "mpg_vs_origin_mean", "type": "quantitative", "title": "MPG minus mean MPG of its origin"},
    "y": {"field": "Origin", "type": "nominal"}
  }
}

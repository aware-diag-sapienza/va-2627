{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Too few bins hide the shape; too many bins show noise. `step` gives round bin edges.",
  "data": {"url": "../data/cars.json"},
  "hconcat": [
    {
      "title": "maxbins: 5",
      "width": 200,
      "height": 200,
      "mark": "bar",
      "encoding": {
        "x": {"field": "Horsepower", "type": "quantitative", "bin": {"maxbins": 5}},
        "y": {"aggregate": "count"}
      }
    },
    {
      "title": "step: 10",
      "width": 200,
      "height": 200,
      "mark": "bar",
      "encoding": {
        "x": {"field": "Horsepower", "type": "quantitative", "bin": {"step": 10}},
        "y": {"aggregate": "count"}
      }
    },
    {
      "title": "maxbins: 60",
      "width": 200,
      "height": 200,
      "mark": "bar",
      "encoding": {
        "x": {"field": "Horsepower", "type": "quantitative", "bin": {"maxbins": 60}},
        "y": {"aggregate": "count"}
      }
    }
  ]
}

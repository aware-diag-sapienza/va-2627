{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "TODO: for each car, compute how far its Miles_per_Gallon is from the mean of its Origin (joinAggregate + calculate) and show the deviations as one strip per origin.",
  "width": 400,
  "height": 150,
  "data": {"url": "../data/cars.json"},
  "mark": {"type": "circle", "opacity": 0.4},
  "encoding": {
    "x": {"field": "Miles_per_Gallon", "type": "quantitative"},
    "y": {"field": "Origin", "type": "nominal"}
  }
}

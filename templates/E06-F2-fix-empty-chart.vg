{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "TODO: the chart of rainy days with the highest precipitation per degree is EMPTY and there is no error. Find the two problems in `transform` (hint: order of transforms, and string values).",
  "width": 500,
  "height": 250,
  "data": {"url": "../data/seattle-weather.csv"},
  "transform": [
    {"filter": "datum.precip_per_degree > 0.1"},
    {"calculate": "datum.precipitation / datum.temp_max", "as": "precip_per_degree"},
    {"filter": "datum.weather == 'Rain'"}
  ],
  "mark": {"type": "circle", "opacity": 0.7},
  "encoding": {
    "x": {"field": "date", "type": "temporal"},
    "y": {"field": "precip_per_degree", "type": "quantitative", "title": "Precipitation per degree"}
  }
}

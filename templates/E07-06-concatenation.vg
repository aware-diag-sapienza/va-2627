{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "TODO: put a histogram of Horsepower above the scatter plot in a single figure (vconcat). The Horsepower axes must be aligned: share the x scale and use the same width.",
  "width": 400,
  "height": 300,
  "data": {"url": "../data/cars.json"},
  "mark": "point",
  "encoding": {
    "x": {"field": "Horsepower", "type": "quantitative"},
    "y": {"field": "Miles_per_Gallon", "type": "quantitative"}
  }
}
